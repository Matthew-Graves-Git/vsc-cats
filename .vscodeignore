# ---- sources and tooling (ships: out/, media/, window/ (CatHost.exe, host.cs for the PowerShell
#      fallback, and the WebView2 SDK files in window/lib), package.json, README, runtime node_modules) ----
.vscode/**
.github/**
src/**
scripts/**
media/icon-src/**
tsconfig.json
.gitignore
claude.md
*.vsix
**/*.map

# ---- node_modules: files Node never loads ----
node_modules/**/*.{ts,mts,cts}
node_modules/**/{README,CHANGELOG,HISTORY}.md
node_modules/**/tsconfig*.json
node_modules/puppeteer-core/{src,lib/esm,lib/es5-iife}/**
node_modules/@puppeteer/browsers/{src,lib/esm}/**

# ---- puppeteer: packages never loaded (Edge/Chrome launch over CDP; we never download a browser) ----
# WebDriver BiDi (Firefox only) and type-only packages
**/node_modules/{chromium-bidi,zod,mitt,devtools-protocol,typed-query-selector}/**
# Bare-runtime builds pulled in by tar-fs/streamx
**/node_modules/{bare-*,teex}/**
# proxy agents, lazily required only when downloading a browser through a proxy
**/node_modules/{http-proxy-agent,https-proxy-agent,socks-proxy-agent,socks,ip-address,smart-buffer,pac-proxy-agent,pac-resolver,degenerator,ast-types,escodegen,esprima,estraverse,esutils,source-map,tslib,netmask,get-uri,basic-ftp,data-uri-to-buffer,@tootallnate}/**
# unbzip2-stream's buffer polyfill (Node resolves require('buffer') to the builtin)
**/node_modules/{buffer,base64-js,ieee754}/**
